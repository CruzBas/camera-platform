# Genera .env con secretos aleatorios: scripts/setup-env.sh
# .env nunca se sube al repositorio.

# Usuario administrador del dashboard (se crea al primer arranque si no hay usuarios).
# La contraseña necesita mayúscula, minúscula, número y símbolo.
ADMIN_EMAIL=admin@camera.local
ADMIN_PASSWORD=

POSTGRES_PASSWORD=
# Contraseña de la API de control de MediaMTX (solo la usa la API de la plataforma).
MEDIAMTX_API_PASSWORD=
# Clave compartida entre el servicio de visión y la API.
VISION_API_KEY=

# Frames analizados por segundo y por cámara.
ANALYSIS_FPS=2
# Hilos de PyTorch por inferencia (más no es mejor: compiten con la decodificación del video).
INFERENCE_THREADS=2

# Modelo detector a utilizar en el servicio de visión:
# yolo (por defecto, ultralytics yolo26n.pt) | rfdetr (RF-DETR ONNX para sitting/standing)
DETECTOR=yolo
# Ruta al modelo ONNX de RF-DETR cuando DETECTOR=rfdetr
RFDETR_MODEL_PATH=/app/models/custom/bus-passengers-rfdetr-s-v1.onnx

# Solo para scripts/probe-camera.sh (Fase 0). La cámara se registra desde el dashboard.
# Rutas habituales en TENVIS: /11 (principal), /12 (secundario); modelos antiguos: /live/ch0.
# Codifica en la contraseña los caracteres especiales (@ → %40, # → %23).
TENVIS_RTSP_URL=rtsp://usuario:contraseña@192.168.1.50:554/11
