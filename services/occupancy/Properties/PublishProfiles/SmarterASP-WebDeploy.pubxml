<?xml version="1.0" encoding="utf-8"?>
<!-- Web Deploy to the SmarterASP temp site. The password is not stored here: Visual Studio asks
     for it and keeps it in the .pubxml.user file next to this one, which git ignores. -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://lg0618pp-002-site2.htempurl.com/simulate</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <!-- Demo turns on the /simulate page (appsettings.Demo.json) and keeps the simulated fleet. -->
    <EnvironmentName>Demo</EnvironmentName>
    <!-- The shared app pool already hosts another ASP.NET Core app in-process (HTTP 500.35), so
         this one runs out-of-process: its own Kestrel process behind IIS. -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <MSDeployServiceURL>https://win1143.site4now.net:8172/msdeploy.axd?site=lg0618pp-002-site2</MSDeployServiceURL>
    <DeployIisAppPath>lg0618pp-002-site2</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>false</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <UserName>lg0618pp-002</UserName>
    <_SavePWD>true</_SavePWD>
    <AllowUntrustedCertificate>true</AllowUntrustedCertificate>
  </PropertyGroup>
</Project>
